{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Run Current Script",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}"
        },
        {
            "name": "Streamlit: Launch App",
            "type": "debugpy",
            "request": "launch",
            "module": "streamlit",
            "args": ["run", "app.py"],
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}"
        },
        {
            "name": "Pipeline: Feature Engineering",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/scripts/feature_engineering.py",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}"
        },
        {
            "name": "Pipeline: Train Ensemble",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/scripts/train_stack.py",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}"
        },
        {
            "name": "Pipeline: Evaluate (Honest)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/scripts/evaluate_pro.py",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}"
        }
    ]
}
